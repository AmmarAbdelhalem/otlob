{
  "info": {
    "_postman_id": "otlob-autoparts-api-collection",
    "name": "Otlob Auto Parts Marketplace & Delivery API",
    "description": "Comprehensive Postman collection for the Otlob on-demand auto parts platform with split cart, courier dispatch, and double-entry ledger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mohamed Salah\",\n  \"phone\": \"01055443322\",\n  \"email\": \"salah@example.com\",\n  \"password\": \"secret123\",\n  \"password_confirmation\": \"secret123\",\n  \"role\": \"customer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (Customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"01012345678\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"01000000000\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Authenticated User (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Catalog & Fitment",
      "item": [
        {
          "name": "Search Products by Vehicle Fitment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/search?make=Toyota&model=Corolla&year=2020",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [
                { "key": "make", "value": "Toyota" },
                { "key": "model", "value": "Corolla" },
                { "key": "year", "value": "2020" }
              ]
            }
          }
        },
        {
          "name": "Search Products by OEM Number",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/search?oem_number=04465-02220",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [{ "key": "oem_number", "value": "04465-02220" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customer & Orders",
      "item": [
        {
          "name": "List Garage Vehicles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/customer/vehicles", "host": ["{{baseUrl}}"], "path": ["customer", "vehicles"] }
          }
        },
        {
          "name": "Add Vehicle to Garage",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Hyundai\",\n  \"model\": \"Elantra\",\n  \"year\": 2021,\n  \"vin\": \"KMHD84LF7MU129034\",\n  \"is_default\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/customer/vehicles", "host": ["{{baseUrl}}"], "path": ["customer", "vehicles"] }
          }
        },
        {
          "name": "Split Cart Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delivery_lat\": 30.0444,\n  \"delivery_lng\": 31.2357,\n  \"payment_type\": \"cod\",\n  \"items\": [\n    {\n      \"product_id\": \"PASTE_PRODUCT_UUID_HERE\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders/checkout", "host": ["{{baseUrl}}"], "path": ["orders", "checkout"] }
          }
        },
        {
          "name": "Track Order Live GPS",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/orders/PASTE_ORDER_UUID_HERE/track", "host": ["{{baseUrl}}"], "path": ["orders", "PASTE_ORDER_UUID_HERE", "track"] }
          }
        }
      ]
    },
    {
      "name": "4. Merchant Store",
      "item": [
        {
          "name": "List Store Sub-Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/merchant/orders", "host": ["{{baseUrl}}"], "path": ["merchant", "orders"] }
          }
        },
        {
          "name": "Update Sub-Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ready_for_pickup\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/merchant/orders/PASTE_ORDER_UUID_HERE/status", "host": ["{{baseUrl}}"], "path": ["merchant", "orders", "PASTE_ORDER_UUID_HERE", "status"] }
          }
        },
        {
          "name": "Get Merchant Wallet & Ledger Statement",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/merchant/wallet", "host": ["{{baseUrl}}"], "path": ["merchant", "wallet"] }
          }
        }
      ]
    },
    {
      "name": "5. Courier Fleet",
      "item": [
        {
          "name": "Ping Live Coordinates (Redis GEO)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 30.0520,\n  \"longitude\": 31.2400\n}"
            },
            "url": { "raw": "{{baseUrl}}/courier/location", "host": ["{{baseUrl}}"], "path": ["courier", "location"] }
          }
        },
        {
          "name": "Toggle Dispatch Readiness (Online/Offline)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_online\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/courier/status", "host": ["{{baseUrl}}"], "path": ["courier", "status"] }
          }
        },
        {
          "name": "Verify Delivery OTP & Settle Ledger",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"482103\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/courier/orders/PASTE_ORDER_UUID_HERE/verify-otp", "host": ["{{baseUrl}}"], "path": ["courier", "orders", "PASTE_ORDER_UUID_HERE", "verify-otp"] }
          }
        }
      ]
    },
    {
      "name": "6. Admin Governance",
      "item": [
        {
          "name": "Platform Financial Revenue Report",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/reports/financials", "host": ["{{baseUrl}}"], "path": ["admin", "reports", "financials"] }
          }
        },
        {
          "name": "Global Orders Oversight",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/orders", "host": ["{{baseUrl}}"], "path": ["admin", "orders"] }
          }
        }
      ]
    }
  ]
}
